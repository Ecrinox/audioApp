<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <!-- PWA iOS Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Audio-Queue">
    <title>Audio-Queue [PWA]</title>
    
    <!-- Tailwind CSS (CDN for standalone file) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">

    <style>
        /* Configuraciones Brutalistas y The Vibe */
        :root {
            --term-green: #00ff41;
            --ind-orange: #ff6600;
            --bg-black: #050505;
        }
        
        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: var(--bg-black);
            color: var(--term-green);
            /* Evitar overscroll en iOS */
            overscroll-behavior-y: none; 
        }

        /* Scrollbar styling para mantener el vibe */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-black);
            border-left: 1px solid var(--term-green);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--term-green);
        }

        .brutal-border {
            border: 2px solid var(--term-green);
            border-radius: 0;
            box-shadow: 4px 4px 0px var(--term-green);
            transition: all 0.1s ease;
        }

        .brutal-border:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px var(--term-green);
        }

        .brutal-border-orange {
            border: 2px solid var(--ind-orange);
            border-radius: 0;
            box-shadow: 4px 4px 0px var(--ind-orange);
        }
        
        .brutal-input {
            background-color: var(--bg-black);
            border: 2px solid var(--term-green);
            color: var(--term-green);
            border-radius: 0;
            outline: none;
        }
        
        .brutal-input:focus {
            border-color: var(--ind-orange);
            box-shadow: 4px 4px 0px var(--ind-orange);
        }

        /* Ajustes de Safe Area para iPhone modernos (Dynamic Island y Home Bar) */
        header {
            padding-top: calc(1rem + env(safe-area-inset-top)) !important;
        }

        /* Layout para que el reproductor quede fijo abajo */
        #app-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            height: 100dvh; /* Para Safari en iOS */
        }
        #main-content {
            flex: 1;
            overflow-y: auto;
            /* Aumentamos el padding para compensar el reproductor más alto por el safe-area */
            padding-bottom: calc(150px + env(safe-area-inset-bottom)); 
        }
        #player-container {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background-color: var(--bg-black);
            border-top: 2px solid var(--term-green);
            z-index: 50;
            padding-bottom: calc(1rem + env(safe-area-inset-bottom)) !important;
        }
    </style>
</head>
<body class="antialiased selection:bg-[#00ff41] selection:text-black">

    <div id="app-container">
        
        <!-- Header -->
        <header class="p-4 border-b-2 border-[#00ff41]">
            <h1 class="text-2xl font-extrabold uppercase tracking-tighter">
                > Audio-Queue_ <span class="animate-pulse text-[#ff6600]">█</span>
            </h1>
            <p class="text-xs opacity-70 mt-1">// Extractor & Lector TTS iOS</p>
        </header>

        <!-- Main Content -->
        <main id="main-content" class="p-4 flex flex-col gap-6">
            
            <!-- Ingesta -->
            <section class="flex flex-col gap-3">
                <label class="text-sm font-bold uppercase">> Ingestar URL:</label>
                <div class="flex gap-2">
                    <input type="url" id="url-input" placeholder="https://..." class="brutal-input p-3 flex-1 w-full" autocomplete="off">
                    <button id="btn-ingest" class="brutal-border bg-black text-[#00ff41] px-4 py-2 font-bold uppercase hover:bg-[#00ff41] hover:text-black">
                        Extraer
                    </button>
                </div>
                <div id="status-msg" class="text-xs hidden text-[#ff6600] font-bold"></div>
            </section>

            <!-- Playlist -->
            <section class="flex flex-col gap-3">
                <div class="flex justify-between items-end border-b-2 border-[#00ff41] pb-2">
                    <label class="text-sm font-bold uppercase">> Playlist_Data:</label>
                    <button id="btn-clear" class="text-xs text-red-500 hover:text-red-400 uppercase">[Purgar_Leídos]</button>
                </div>
                <ul id="playlist-container" class="flex flex-col gap-3">
                    <!-- Los items se inyectan acá vía JS -->
                </ul>
            </section>

        </main>

        <!-- Reproductor Fijo -->
        <footer id="player-container" class="p-4 flex flex-col gap-3">
            <div class="flex justify-between items-center">
                <div class="truncate pr-4 text-sm font-bold" id="now-playing-title">
                    [NO_DATA_SELECTED]
                </div>
                <div class="text-xs border border-[#00ff41] px-1" id="voice-indicator">
                    VOZ: --
                </div>
            </div>
            
            <div class="flex items-center gap-4">
                <button id="btn-play-pause" class="brutal-border-orange bg-[#ff6600] text-black px-6 py-3 font-extrabold uppercase w-1/3 hover:bg-black hover:text-[#ff6600]">
                    PLAY
                </button>
                
                <div class="flex-1 flex flex-col gap-1">
                    <label class="text-xs uppercase flex justify-between">
                        <span>Velocidad (Rate)</span>
                        <span id="rate-val">1.0x</span>
                    </label>
                    <input type="range" id="rate-slider" min="0.5" max="2" step="0.1" value="1" class="w-full accent-[#00ff41]">
                </div>
            </div>
            
            <div class="w-full bg-black border border-[#00ff41] h-2 mt-1 relative">
                <div id="progress-bar" class="absolute top-0 left-0 h-full bg-[#00ff41] w-0 transition-all duration-300"></div>
            </div>
        </footer>

    </div>

    <!-- Script Principal -->
    <script>
        /**
         * ESTADO DE LA APLICACIÓN
         */
        let playlist = JSON.parse(localStorage.getItem('audioQueue_v1')) || [];
        let currentVoice = null;
        let isPlaying = false;
        let currentItemIndex = -1;
        
        // Manejo de la cola de fragmentos (chunks) para evitar el bug de iOS
        let textChunks = [];
        let currentChunkIndex = 0;

        // Referencias DOM
        const urlInput = document.getElementById('url-input');
        const btnIngest = document.getElementById('btn-ingest');
        const statusMsg = document.getElementById('status-msg');
        const playlistContainer = document.getElementById('playlist-container');
        const btnClear = document.getElementById('btn-clear');
        
        const nowPlayingTitle = document.getElementById('now-playing-title');
        const voiceIndicator = document.getElementById('voice-indicator');
        const btnPlayPause = document.getElementById('btn-play-pause');
        const rateSlider = document.getElementById('rate-slider');
        const rateVal = document.getElementById('rate-val');
        const progressBar = document.getElementById('progress-bar');

        /**
         * INICIALIZACIÓN DE VOCES (SPEECH SYNTHESIS API)
         */
        function initVoices() {
            let voices = window.speechSynthesis.getVoices();
            if (voices.length === 0) return;

            // Filtros de búsqueda para voces "Premium" o mejoradas, preferentemente en español
            const isPremiumSpanish = (v) => 
                v.lang.startsWith('es') && 
                (v.name.includes('Premium') || v.name.includes('Enhanced') || v.name.includes('Monica') || v.name.includes('Paulina') || v.name.includes('Jorge') || v.name.includes('Google'));

            const isAnySpanish = (v) => v.lang.startsWith('es');

            // 1. Intentar Premium ES
            currentVoice = voices.find(isPremiumSpanish);
            // 2. Fallback a cualquier ES
            if (!currentVoice) currentVoice = voices.find(isAnySpanish);
            // 3. Fallback absoluto
            if (!currentVoice) currentVoice = voices[0];

            if (currentVoice) {
                let shortName = currentVoice.name.split(' ')[0].substring(0, 10);
                voiceIndicator.innerText = `VOZ: ${shortName}`;
            }
        }

        // iOS y Chrome cargan las voces de forma asíncrona
        window.speechSynthesis.onvoiceschanged = initVoices;
        initVoices(); // Intento inicial

        /**
         * EXTRACCIÓN DE CONTENIDO (r.jina.ai)
         */
        btnIngest.addEventListener('click', async () => {
            const url = urlInput.value.trim();
            if (!url) return;

            try {
                // UI update
                urlInput.disabled = true;
                btnIngest.disabled = true;
                btnIngest.innerText = "[ FETCHING... ]";
                statusMsg.classList.remove('hidden');
                statusMsg.innerText = ">> Consultando r.jina.ai Proxy...";

                const proxyUrl = `https://r.jina.ai/${url}`;
                const response = await fetch(proxyUrl);
                
                if (!response.ok) throw new Error("Error en la extracción");
                
                const text = await response.text();
                
                // Procesamiento básico del texto (Jina devuelve Markdown)
                // Usamos la primera línea no vacía como título estimado si empieza con # o es corta
                const lines = text.split('\n').filter(l => l.trim().length > 0);
                let title = lines[0].replace(/#/g, '').trim().substring(0, 60) + "...";
                
                // Limpieza del texto para lectura
                let cleanText = text
                    .replace(/\[.*?\]\(.*?\)/g, '') // Quitar links markdown
                    .replace(/[*_#`]/g, '')         // Quitar formato markdown
                    .replace(/(https?:\/\/[^\s]+)/g, 'enlace omitido'); // Evitar que lea URLs enteras

                // Crear objeto
                const newItem = {
                    id: Date.now().toString(),
                    url: url,
                    title: title,
                    text: cleanText,
                    status: 'Pendiente' // Pendiente, Escuchando, Leido
                };

                playlist.unshift(newItem); // Agregar arriba
                savePlaylist();
                renderPlaylist();

                // Reset UI
                urlInput.value = '';
                statusMsg.innerText = ">> Extracción Exitosa.";
                setTimeout(() => statusMsg.classList.add('hidden'), 3000);

            } catch (error) {
                console.error(error);
                statusMsg.innerText = "[!] ERROR: " + error.message;
            } finally {
                urlInput.disabled = false;
                btnIngest.disabled = false;
                btnIngest.innerText = "EXTRAER";
            }
        });

        /**
         * RENDERIZADO DE LA PLAYLIST
         */
        function renderPlaylist() {
            playlistContainer.innerHTML = '';
            
            if(playlist.length === 0) {
                playlistContainer.innerHTML = `<li class="text-xs opacity-50 border border-dashed border-[#00ff41] p-4 text-center">No hay datos en la cola.</li>`;
                return;
            }

            playlist.forEach((item, index) => {
                const li = document.createElement('li');
                li.className = `p-3 border-2 ${item.status === 'Escuchando' ? 'border-[#ff6600]' : 'border-[#00ff41]'} bg-black flex flex-col gap-2`;
                
                let statusColor = item.status === 'Leido' ? 'text-gray-500' : (item.status === 'Escuchando' ? 'text-[#ff6600]' : 'text-[#00ff41]');

                li.innerHTML = `
                    <div class="flex justify-between items-start">
                        <span class="text-sm font-bold truncate pr-2" title="${item.url}">${item.title}</span>
                        <span class="text-[10px] uppercase border px-1 ${statusColor} border-current">${item.status}</span>
                    </div>
                    <div class="flex justify-between items-center mt-2">
                        <button onclick="loadAndPlay(${index})" class="text-xs bg-[#00ff41] text-black px-2 py-1 uppercase font-bold hover:bg-white transition-colors">
                            [ Cargar ]
                        </button>
                        <button onclick="deleteItem('${item.id}')" class="text-xs text-red-500 hover:text-red-400">
                            [x]
                        </button>
                    </div>
                `;
                playlistContainer.appendChild(li);
            });
        }

        function savePlaylist() {
            localStorage.setItem('audioQueue_v1', JSON.stringify(playlist));
        }

        function deleteItem(id) {
            playlist = playlist.filter(item => item.id !== id);
            savePlaylist();
            renderPlaylist();
        }

        btnClear.addEventListener('click', () => {
            playlist = playlist.filter(item => item.status !== 'Leido');
            savePlaylist();
            renderPlaylist();
        });

        /**
         * MOTOR DE REPRODUCCIÓN (TEXT-TO-SPEECH)
         */

        // Cargar un ítem específico al reproductor
        window.loadAndPlay = function(index) {
            // Detener lectura actual
            window.speechSynthesis.cancel();
            isPlaying = false;
            
            // Actualizar estados
            if(currentItemIndex !== -1 && playlist[currentItemIndex]) {
                if(playlist[currentItemIndex].status === 'Escuchando') {
                    playlist[currentItemIndex].status = 'Pendiente'; // O 'Leido' dependiendo de la lógica que prefieras
                }
            }
            
            currentItemIndex = index;
            playlist[currentItemIndex].status = 'Escuchando';
            nowPlayingTitle.innerText = playlist[currentItemIndex].title;
            
            savePlaylist();
            renderPlaylist();

            // Preparar el texto (CHUNKED para iOS)
            // iOS Safari corta el audio si el texto es muy largo. Dividimos por párrafos o frases.
            const fullText = playlist[currentItemIndex].text;
            // Expresión regular para dividir por puntos seguidos de espacio o saltos de línea
            textChunks = fullText.split(/(?<=\.)\s+|\n+/).filter(chunk => chunk.trim().length > 0);
            currentChunkIndex = 0;
            progressBar.style.width = '0%';

            // NO autocomienza la reproducción. Requiere que el usuario presione PLAY (Regla de iOS)
            btnPlayPause.innerText = "PLAY (LISTO)";
            btnPlayPause.classList.remove('bg-red-500');
            btnPlayPause.classList.add('bg-[#ff6600]');
        };

        // Lógica Principal de Reproducción (El botón PLAY)
        btnPlayPause.addEventListener('click', () => {
            if (currentItemIndex === -1) {
                alert(">> Carga un artículo primero.");
                return;
            }

            if (isPlaying) {
                window.speechSynthesis.pause();
                isPlaying = false;
                btnPlayPause.innerText = "RESUME";
                btnPlayPause.classList.replace('bg-red-500', 'bg-[#ff6600]');
            } else {
                if (window.speechSynthesis.paused) {
                    window.speechSynthesis.resume();
                } else {
                    // Iniciar nueva lectura del chunk actual
                    playCurrentChunk();
                }
                isPlaying = true;
                btnPlayPause.innerText = "PAUSE";
                btnPlayPause.classList.replace('bg-[#ff6600]', 'bg-red-500');
            }
        });

        function playCurrentChunk() {
            if (currentChunkIndex >= textChunks.length) {
                // Finalizó el artículo
                isPlaying = false;
                btnPlayPause.innerText = "PLAY";
                btnPlayPause.classList.replace('bg-red-500', 'bg-[#ff6600]');
                
                playlist[currentItemIndex].status = 'Leido';
                savePlaylist();
                renderPlaylist();
                progressBar.style.width = '100%';
                nowPlayingTitle.innerText = "[ FIN ]";
                return;
            }

            const chunk = textChunks[currentChunkIndex];
            const utterance = new SpeechSynthesisUtterance(chunk);
            
            if (currentVoice) utterance.voice = currentVoice;
            utterance.rate = parseFloat(rateSlider.value);
            
            utterance.onend = () => {
                currentChunkIndex++;
                updateProgress();
                // Reproducir el siguiente de inmediato
                playCurrentChunk(); 
            };

            utterance.onerror = (e) => {
                console.error("Error TTS:", e);
                isPlaying = false;
                btnPlayPause.innerText = "ERROR";
            };

            window.speechSynthesis.speak(utterance);
        }

        function updateProgress() {
            if(textChunks.length === 0) return;
            const percentage = ((currentChunkIndex) / textChunks.length) * 100;
            progressBar.style.width = `${percentage}%`;
        }

        // Actualizar slider
        rateSlider.addEventListener('input', (e) => {
            rateVal.innerText = `${e.target.value}x`;
        });

        // Init UI
        renderPlaylist();

    </script>
</body>
</html>
